{
  "project": {
    "name": "RH Turbo 360 - Landing Page",
    "description": "Landing page de alta conversão para o método RH Turbo 360 com 12 agentes de IA",
    "framework": "React + TypeScript + Vite",
    "styling": "Tailwind CSS"
  },
  "design_system": {
    "fonts": {
      "heading": "Inter (Google Fonts)",
      "body": "Open Sans (Google Fonts)",
      "weights": [400, 500, 600, 700, 800]
    },
    "colors": {
      "backgrounds": {
        "dark": {
          "hsl": "222 75% 6%",
          "hex": "#0B1020",
          "usage": "Seções escuras, header sticky"
        },
        "light": {
          "hsl": "220 30% 96%",
          "hex": "#F4F6FA",
          "usage": "Seções claras, fundo de cards"
        }
      },
      "text": {
        "on_dark": {
          "hsl": "0 0% 100%",
          "hex": "#FFFFFF",
          "usage": "Texto principal em fundo escuro"
        },
        "muted_dark": {
          "hsl": "214 32% 80%",
          "hex": "#CBD5E1",
          "usage": "Texto secundário em fundo escuro"
        },
        "on_light": {
          "hsl": "222 75% 6%",
          "hex": "#0B1020",
          "usage": "Texto em fundo claro"
        }
      },
      "accents": {
        "orange": {
          "hsl": "20 100% 62%",
          "hex": "#FF8A3D",
          "usage": "Destaques, ícones, badges"
        },
        "magenta": {
          "hsl": "344 100% 59%",
          "hex": "#FF2E6D",
          "usage": "Elementos interativos, timer"
        },
        "cta_pink": {
          "hsl": "344 100% 69%",
          "hex": "#FF5F8F",
          "usage": "Início do gradiente CTA"
        },
        "cta_orange": {
          "hsl": "28 100% 68%",
          "hex": "#FFA65C",
          "usage": "Fim do gradiente CTA"
        }
      }
    },
    "gradients": {
      "cta": "linear-gradient(135deg, hsl(344 100% 69%), hsl(28 100% 68%))",
      "cta_hover": "linear-gradient(135deg, hsl(344 100% 64%), hsl(28 100% 63%))",
      "text": "bg-gradient-to-r from-rh-cta-pink to-rh-cta-orange"
    },
    "spacing": {
      "section_padding_mobile": "4rem 1rem",
      "section_padding_desktop": "6rem 1rem",
      "container_max_width": "1280px"
    },
    "borders": {
      "radius": "1rem",
      "radius_xl": "1.5rem",
      "radius_2xl": "1.5rem",
      "color_light": "hsl(220 13% 91%)"
    },
    "shadows": {
      "soft": "0 10px 30px -10px hsl(222 75% 6% / 0.15)",
      "glow": "0 0 40px hsl(344 100% 69% / 0.3)"
    },
    "animations": {
      "fade_in": {
        "duration": "0.6s",
        "timing": "ease-out",
        "from": {
          "opacity": 0,
          "transform": "translateY(20px)"
        },
        "to": {
          "opacity": 1,
          "transform": "translateY(0)"
        }
      },
      "slide_up": {
        "duration": "0.5s",
        "timing": "ease-out"
      }
    },
    "transitions": {
      "smooth": "all 0.3s cubic-bezier(0.4, 0, 0.2, 1)"
    }
  },
  "components": {
    "CTAButton": {
      "file": "src/components/VendasRH/CTAButton.tsx",
      "variants": {
        "primary": {
          "style": "Gradiente rosa-laranja com sombra e hover scale",
          "classes": "bg-gradient-to-r from-rh-cta-pink to-rh-cta-orange"
        },
        "secondary": {
          "style": "Borda com hover bg claro",
          "classes": "border-2 border-current hover:bg-white/10"
        }
      },
      "sizes": {
        "default": "px-8 py-4 text-base",
        "lg": "px-10 py-5 text-lg"
      },
      "props": ["variant", "size", "onClick", "className", "children"]
    },
    "SectionWrapper": {
      "file": "src/components/VendasRH/SectionWrapper.tsx",
      "variants": {
        "dark": "section-dark (fundo escuro #0B1020)",
        "light": "section-light (fundo claro #F4F6FA)"
      },
      "props": ["variant", "children", "className", "id"]
    },
    "CountdownTimer": {
      "file": "src/components/VendasRH/CountdownTimer.tsx",
      "description": "Timer regressivo de 59 minutos",
      "style": "Números grandes com fundo branco em cards arredondados",
      "state": "timeLeft (em segundos)",
      "update_interval": "1 segundo"
    },
    "TestimonialCard": {
      "file": "src/components/VendasRH/TestimonialCard.tsx",
      "structure": {
        "quote": "Texto ou imagem do depoimento",
        "author": {
          "avatar": "Imagem circular 48x48px",
          "name": "Nome em negrito",
          "role": "Cargo",
          "company": "Empresa"
        },
        "result": "Badge com resultado destaque"
      },
      "props": ["quote", "name", "role", "company", "result", "avatar"]
    },
    "ModuleCard": {
      "file": "src/components/VendasRH/ModuleCard.tsx",
      "description": "Card expansível com lista de agentes de IA",
      "structure": {
        "header": {
          "icon": "Emoji 3xl",
          "title": "Título do módulo",
          "toggle": "Ícone chevron animado"
        },
        "content": {
          "agents": [
            {
              "name": "Nome do agente",
              "description": "Descrição funcional"
            }
          ]
        }
      },
      "state": "isOpen (boolean)",
      "animation": "max-height com transição suave"
    },
    "FAQItem": {
      "file": "src/components/VendasRH/FAQItem.tsx",
      "description": "Item de FAQ com pergunta/resposta expansível",
      "props": ["question", "answer"],
      "state": "isOpen (boolean)"
    }
  },
  "pages": {
    "VendasRHTurbo360": {
