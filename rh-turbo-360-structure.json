    "og_type": "product",
    "og_title": "RH Turbo 360 — Automatize RH com IA",
    "og_description": "12 agentes de IA para transformar seu RH: do diagnóstico ao desligamento humanizado.",
    "twitter_card": "summary_large_image",
    "canonical": "/vendas-rh-turbo360"
  },
  "analytics": {
    "facebook_pixel": {
      "events": [
        "PageView (on mount)",
        "InitiateCheckout (on CTA click)"
      ],
      "parameters": {
        "content_name": "RH Turbo 360",
        "content_category": "Curso",
        "value": 197.0,
        "currency": "BRL"
      }
    },
    "google_analytics": {
      "events": [
        {
          "name": "purchase_click",
          "category": "CTA",
          "label": "location (header, hero, urgencia, etc)"
        }
      ]
    }
  },
  "cta_locations": [
    "header (desktop only)",
    "hero (seção 1)",
    "problema (seção 2)",
    "urgencia (seção 6)",
    "garantia (seção 7)",
    "cta-final (seção 10)"
  ],
